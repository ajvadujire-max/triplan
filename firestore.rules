rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /admins/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /trips/{tripId} {
      allow create: if isAuthenticated();
      allow read: if true; // Allows fetching by code before login
      allow update, delete: if isAuthenticated() && (resource.data.organizerUid == request.auth.uid || resource.data.organizerId == request.auth.uid || isSuperAdmin());

      // Registrations subcollection
      match /registrations/{regId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /accounts/{accountId} {
      allow read, write: if isAuthenticated();
    }

    match /cashbook/{entryId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
