rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    function isOrganizer() {
      return isAuthenticated() && (
        getUserData().role == 'organizer' || 
        getUserData().role == 'super_admin'
      );
    }

    function isTripOrganizer(tripData) {
      return isAuthenticated() && (
        tripData.organizerUid == request.auth.uid || 
        tripData.organizerId == request.auth.uid || 
        isSuperAdmin()
      );
    }

    match /users/{userId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /admins/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /trips/{tripId} {
      allow create: if isAuthenticated();
      allow read: if true; // Publicly fetchable by invite code
      
      // Full update/delete restricted to Trip Organizer or Super Admin
      // Travellers can update expenses, travellers array, pendingRegistrations, memberUids, members, or updatedAt when joining/adding expenses or editing profile
      allow delete: if isTripOrganizer(resource.data);
      allow update: if isAuthenticated() && (
        isTripOrganizer(resource.data) ||
        request.auth.uid in request.resource.data.memberUids ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expenses', 'travellers', 'pendingRegistrations', 'memberUids', 'members', 'updatedAt'])
      );

      // Subcollections
      match /registrations/{registrationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && registrationId == request.auth.uid;
        allow delete: if isAuthenticated() && (registrationId == request.auth.uid || isTripOrganizer(get(/databases/$(database)/documents/trips/$(tripId)).data));
      }

      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    match /accounts/{accountId} {
      allow read, write: if isAuthenticated();
    }

    match /cashbook/{entryId} {
      allow read, write: if isAuthenticated();
    }

    match /personalExpenses/{expenseId} {
      allow create: if isAuthenticated() && request.resource.data.travellerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.travellerUid == request.auth.uid;
    }

    match /travelDiaries/{diaryId} {
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    match /checklistItems/{itemId} {
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.tripId != null;
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isTripOrganizer(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data));
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
