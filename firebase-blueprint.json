{
  "entities": {
    "Organization": {
      "title": "Organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string" },
        "organizationId": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Trip": {
      "title": "Trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "destination": { "type": "string" },
        "organizationId": { "type": "string" },
        "organizerId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Traveller": {
      "title": "Traveller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "amount": { "type": "number" }
      }
    },
    "Journey": {
      "title": "Journey",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" }
      }
    },
    "Budget": {
      "title": "Budget",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" }
      }
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "fullName": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "InviteLink": {
      "title": "InviteLink",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "Role": {
      "title": "Role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "Permission": {
      "title": "Permission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roleId": { "type": "string" },
        "action": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/organizations/{organizationId}": { "schema": "Organization" },
    "/users/{userId}": { "schema": "User" },
    "/trips/{tripId}": { "schema": "Trip" },
    "/travellers/{travellerId}": { "schema": "Traveller" },
    "/expenses/{expenseId}": { "schema": "Expense" },
    "/journeys/{journeyId}": { "schema": "Journey" },
    "/budgets/{budgetId}": { "schema": "Budget" },
    "/joinRequests/{requestId}": { "schema": "JoinRequest" },
    "/inviteLinks/{linkId}": { "schema": "InviteLink" },
    "/roles/{roleId}": { "schema": "Role" },
    "/permissions/{permissionId}": { "schema": "Permission" }
  }
}
