{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Trip": {
      "title": "Trip",
      "description": "Core trip metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "destination": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "currency": { "type": "string" },
        "totalBudget": { "type": "number" },
        "inviteCode": { "type": "string" },
        "organizerUid": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "TripMember": {
      "title": "TripMember",
      "description": "User role and access within a trip.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["organizer", "traveller", "driver"] },
        "status": { "type": "string", "enum": ["active", "pending", "removed"] },
        "joinedAt": { "type": "string" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial records for a trip.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "paidBy": { "type": "string" },
        "splitType": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Traveller": {
      "title": "Traveller",
      "description": "Detailed traveller info within a trip.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "role": { "type": "string" },
        "allocatedBudget": { "type": "number" }
      }
    },
    "JourneySegment": {
      "title": "JourneySegment",
      "description": "Itinerary segments.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Collection": {
      "title": "Collection",
      "description": "Group fund collections.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Registration": {
      "title": "Registration",
      "description": "Join requests for a trip.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "requestedAt": { "type": "string" }
      }
    },
    "PersonalExpense": {
      "title": "PersonalExpense",
      "description": "Private financial records for an individual traveller.",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "travellerUid": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tripId", "travellerUid", "title", "amount", "category", "date"]
    },
    "TravelDiary": {
      "title": "TravelDiary",
      "description": "Private personal travel diary entry for a traveller.",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "travellerName": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "content": { "type": "string" },
        "mood": { "type": "string" },
        "photos": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tripId", "ownerUid", "date", "title", "content"]
    },
    "RouteSession": {
      "title": "RouteSession",
      "description": "A single tracking session for a trip.",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "userId": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "ended"] },
        "totalDistance": { "type": "number" },
        "totalDuration": { "type": "number" }
      },
      "required": ["tripId", "userId", "startTime", "status"]
    },
    "RoutePoint": {
      "title": "RoutePoint",
      "description": "A single GPS point within a route session.",
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "timestamp": { "type": "string" },
        "accuracy": { "type": "number" },
        "speed": { "type": "number" }
      },
      "required": ["lat", "lng", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles." },
    "/trips/{tripId}": { "schema": "Trip", "description": "Trips collection." },
    "/trips/{tripId}/members/{userId}": { "schema": "TripMember", "description": "Trip membership." },
    "/trips/{tripId}/expenses/{expenseId}": { "schema": "Expense", "description": "Trip expenses." },
    "/trips/{tripId}/travellers/{travellerId}": { "schema": "Traveller", "description": "Detailed travellers." },
    "/trips/{tripId}/journey/{segmentId}": { "schema": "JourneySegment", "description": "Trip itinerary segments." },
    "/trips/{tripId}/collections/{collectionId}": { "schema": "Collection", "description": "Group collections." },
    "/trips/{tripId}/registrations/{registrationId}": { "schema": "Registration", "description": "Join requests." },
    "/personalExpenses/{expenseId}": { "schema": "PersonalExpense", "description": "Private personal expenses." },
    "/travelDiaries/{diaryId}": { "schema": "TravelDiary", "description": "Private travel diary entries." },
    "/trips/{tripId}/routeSessions/{sessionId}": { "schema": "RouteSession", "description": "Trip route sessions." },
    "/trips/{tripId}/routeSessions/{sessionId}/points/{pointId}": { "schema": "RoutePoint", "description": "GPS points for a route session." }
  }
}
